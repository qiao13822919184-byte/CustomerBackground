# Copy to .env on the server. Never commit .env or production data.
API_URL=https://once.novai.su
API_KEY=
MODEL=[次-流抗截]gemini-3.1-pro-preview
ALTERNATE_MODEL=[次]claude-opus-5
# Use your actual external HTTPS origin when behind a reverse proxy.
# Production compose requires APP_DOMAIN and derives APP_ORIGIN=https://APP_DOMAIN.
# Bare hostname only, without https://, port, path or trailing slash. Leave blank until selected.
APP_DOMAIN=
# The value below is used only without compose.production.yaml.
APP_ORIGIN=https://research.example.com
HOST=127.0.0.1
PORT=8787
# Optional outbound HTTPS proxy for an environment that already uses one.
# OUTBOUND_PROXY_URL=http://127.0.0.1:7890
# Optional Brave Search key; default search uses publicly accessible Bing RSS.
# SEARCH_API_KEY=
